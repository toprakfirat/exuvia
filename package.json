{
  "name": "exuvia",
  "private": true,
  "version": "0.1.0",
  "description": "Character-first AI assistant on top of openclaw.",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:plugin": "pnpm --filter @exuvia/openclaw-plugin dev",
    "dev:app": "pnpm --filter exuvia-app dev",
    "dist": "pnpm --filter @exuvia/openclaw-plugin build && pnpm --filter exuvia-app dist",
    "dist:linux": "pnpm --filter @exuvia/openclaw-plugin build && pnpm --filter exuvia-app dist:linux"
  }
}
