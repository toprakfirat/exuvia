{
  "name": "exuvia-app",
  "version": "0.0.0",
  "private": true,
  "description": "Exuvia desktop app — Electron + React + Three.js shell that talks to OpenClaw.",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}
